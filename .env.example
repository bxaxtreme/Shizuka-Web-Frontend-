# Public website URL; this may use NEXT_PUBLIC_ because it is not a secret.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# MongoDB Atlas (server-only secret; never prefix with NEXT_PUBLIC_)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=shizuka

# Long random secrets. Keep these private in Vercel Environment Variables.
BOT_API_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-at-least-32-random-characters

# Create an OAuth2 application in the Discord Developer Portal.
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-application-client-secret
DISCORD_REDIRECT_URI=https://your-project.vercel.app/api/auth/discord/callback

# Optional: add the bot's public invite URL only if it is correct.
